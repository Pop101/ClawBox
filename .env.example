# NOTE: Model providers (API keys, model names, fallback order) are configured in
# models.json, NOT here. Copy models.example.json → models.json and add your keys there.

# Deploy — Used for OracleCloud script only
OCI_AUTH_TOKEN=xyzxyz

# Owner identity — used in prompts, emails, and calls
OWNER_NAME=YourName
OWNER_EMAIL=you@example.com

# Context limit — if set, ALL models capped. If unset, per-model windows used.
# CONTEXT_TOKENS=32000

# ── Channels ──

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOW_FROM=your-telegram-user-id
# SIGNAL_NUMBER=+1234567890
# SIGNAL_ALLOW_FROM=+1234567890

# ── Tools ──

GITHUB_TOKEN=your-github-personal-access-token
VAPI_API_KEY=your-vapi-api-key
VAPI_ASSISTANT_ID=your-assistant-id
VAPI_PHONE_NUMBER_ID=your-phone-number-id
RECLAIM_API_KEY=your-reclaim-api-key
TAVILY_API_KEY=your-tavily-api-key
GOG_KEYRING_PASSWORD=openclaw
CAPSOLVER_API_KEY=your-capsolver-api-key
SMS_GATEWAY_URL=https://api.sms-gate.app:443
SMS_GATEWAY_USERNAME=your-username
SMS_GATEWAY_PASSWORD=your-password
STEALTH_BROWSER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36"
