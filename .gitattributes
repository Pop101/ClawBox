# Force LF line endings for files that run inside the Linux Docker container.
# Without this, Windows checkouts with core.autocrlf=true produce CRLF,
# which breaks bash scripts and supervisord configs.
*.sh        text eol=lf
*.conf      text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
Dockerfile  text eol=lf
Dockerfile* text eol=lf
