{
  "order": [
    "kimi"
  ],
  "heartbeatModel": "kimi",
  "providers": {
    "kimi": {
      "alias": "kimi",
      "provider": "kimi",
      "api": "anthropic-messages",
      "baseUrl": "https://api.kimi.com/coding",
      "apiKey": "{{KIMI_API_KEY}}",
      "model": "kimi-for-coding",
      "headers": {
        "User-Agent": "claude-code/0.1.0"
      },
      "contextWindow": 262144,
      "input": [
        "text",
        "image"
      ],
      "reasoning": true,
      "cost": {
        "input": 0,
        "output": 0,
        "cacheRead": 0,
        "cacheWrite": 0
      },
      "vision": true
    }
  },
  "mcpServers": {
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "oauthFile": "/home/clawuser/credentials/notion-oauth.json",
      "description": "Notion — personal OAuth, no integration needed. Run: node scripts/notion-auth.js"
    }
  }
}
