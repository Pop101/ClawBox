{
  "order": ["claude", "remote", "local", "gemini"],
  "heartbeatModel": "claude",

  "providers": {
    "claude": {
      "alias": "haiku",
      "provider": "anthropic",
      "api": "anthropic-messages",
      "baseUrl": "https://api.anthropic.com",
      "apiKey": "sk-ant-api03-YOUR-KEY-HERE",
      "model": "claude-haiku-4-5",
      "contextWindow": 200000,
      "input": ["text", "image"],
      "cost": { "input": 1, "output": 5, "cacheRead": 0.1, "cacheWrite": 1.25 },
      "extras": {
        "upgradeModel": "claude-sonnet-4-6",
        "upgradeAlias": "sonnet",
        "upgradeCost": { "input": 3, "output": 15, "cacheRead": 0.3, "cacheWrite": 3.75 },
        "upgradeContextWindow": 1000000
      }
    },
    "remote": {
      "alias": "remote",
      "provider": "remote",
      "api": "openai-completions",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKey": "sk-or-v1-YOUR-KEY-HERE",
      "model": "minimax/minimax-m2.7",
      "contextWindow": 204800,
      "cost": { "input": 0.45, "output": 2.2, "cacheRead": 0, "cacheWrite": 0 }
    },
    "local": {
      "alias": "local",
      "provider": "selfhost",
      "api": "openai-completions",
      "baseUrl": "http://127.0.0.1:8080/v1",
      "apiKey": "your-key",
      "model": "your-model.gguf",
      "contextWindow": 128000,
      "input": ["text"],
      "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
    },
    "gemini": {
      "alias": "gemini",
      "provider": "google",
      "api": "google-generative-ai",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "apiKey": "YOUR-GEMINI-KEY",
      "model": "gemini-3.1-flash-preview",
      "contextWindow": 1048576,
      "input": ["text", "image"],
      "cost": { "input": 0.5, "output": 3, "cacheRead": 0.05, "cacheWrite": 0.5 },
      "vision": true
    }
  },

  "mcpServers": {
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "oauthFile": "/home/clawuser/credentials/notion-oauth.json",
      "description": "Notion — personal OAuth, no integration needed. Run: node scripts/notion-auth.js"
    },
    "claude-code": {
      "command": "claude",
      "args": ["mcp", "serve"],
      "env": { "ANTHROPIC_API_KEY": "{{ANTHROPIC_API_KEY}}" },
      "description": "Claude Code — coding tasks"
    }
  }
}
