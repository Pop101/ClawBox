# NOTE: Model providers (model names, fallback order) are configured in
# models.json — copy models.example.json → models.json.
# API keys are referenced via {{VAR}} templates in models.json and resolved from here.

# ── Model API keys (referenced by {{VAR}} in models.json) ──
# KIMI_API_KEY=your-kimi-api-key
# MOONSHOT_API_KEY=your-moonshot-api-key

# Deploy — Used for OracleCloud script only
OCI_AUTH_TOKEN=xyzxyz

# Owner identity — templated into prompts so the agent knows the user's name
# and primary email. NOT used as a filter — the relay auto-discovers all
# configured himalaya + gog gmail accounts.
OWNER_NAME=YourName
OWNER_EMAIL=you@example.com

# Context limit — if set, ALL models capped. If unset, per-model windows used.
# CONTEXT_TOKENS=32000

# Quiet hours — heartbeat does nothing during this window (saves tokens)
QUIET_HOURS_START=23
QUIET_HOURS_END=7

# ── Channels ──

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOW_FROM=your-telegram-user-id
# SIGNAL_NUMBER=+1234567890
# SIGNAL_ALLOW_FROM=+1234567890

# ── Tools ──

GITHUB_TOKEN=your-github-personal-access-token
VAPI_API_KEY=your-vapi-api-key
VAPI_ASSISTANT_ID=your-assistant-id
VAPI_PHONE_NUMBER_ID=your-phone-number-id
RECLAIM_API_KEY=your-reclaim-api-key
TAVILY_API_KEY=your-tavily-api-key
GOG_KEYRING_PASSWORD=openclaw
SMS_GATEWAY_URL=https://api.sms-gate.app:443
SMS_GATEWAY_USERNAME=your-username
SMS_GATEWAY_PASSWORD=your-password

# ── Relay tuning (optional) ──
# SMS_DEBOUNCE_MS=5000         # how long to wait after a text before dispatching to agent (coalesces rapid-fire texts)
# RELAY_POLL_INTERVAL=120000   # email poll cadence in ms (default 2 min)
